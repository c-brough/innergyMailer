{
  "manifest_version": 3,
  "name": "InnerCider",
  "version": "1.18.6",
  "description": "Tools for Innergy: draft a PO email with the exported PDF attached, show total cost per Default/Purchasing UoM on the Materials grid, and link work-order shipment items back to the BOM they were pushed from.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "storage", "identity"],
  "host_permissions": [
    "https://app.innergy.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://*.blob.core.windows.net/*"
  ],
  "background": { "service_worker": "background/background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://app.innergy.com/*"],
      "js": [
        "content/core.js",
        "content/features/draft-email.js",
        "content/features/materials-cost.js",
        "content/features/bom-backlinks.js",
        "content/features/time-tracking.js",
        "content/features/notes-enhancements.js",
        "content/features/note-drafts.js",
        "content/features/change-order-wizard.js",
        "content/features/change-order-wizard-takeoff.js",
        "content/features/notifications-sidebar.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.innergy.com/*"],
      "js": [
        "content/features/export-capture-main.js",
        "content/features/materials-read-main.js",
        "content/features/time-tracking-main.js",
        "content/features/change-order-wizard-main.js",
        "content/features/change-order-wizard-takeoff-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
