{
  "manifest_version": 3,
  "name": "InnerCider",
  "version": "1.1.0",
  "description": "Tools for Innergy: draft a PO email with the exported PDF attached, show total cost per Default/Purchasing UoM on the Materials grid, and link work-order shipment items back to the BOM they were pushed from.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "storage"],
  "host_permissions": ["https://app.innergy.com/*"],
  "background": { "service_worker": "background/background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://app.innergy.com/*"],
      "js": [
        "content/core.js",
        "content/features/draft-email.js",
        "content/features/materials-cost.js",
        "content/features/bom-backlinks.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
